{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents any user in the system (Admin, Manager, Teacher, Student, Parent).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "role": { 
          "type": "string", 
          "enum": ["super_admin", "school_manager", "teacher", "student", "parent"],
          "description": "User's role in the system"
        },
        "schoolId": { "type": "string", "description": "ID of the school the user belongs to (if applicable)" },
        "classId": { "type": "string", "description": "ID of the class the student belongs to" },
        "studentIds": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of student UIDs (for parents)"
        },
        "parentIds": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of parent UIDs (for students)"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "School": {
      "title": "School",
      "description": "Represents a school entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "managerId": { "type": "string", "description": "UID of the school manager" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Class": {
      "title": "Class",
      "description": "Represents a class within a school.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "teacherId": { "type": "string", "description": "UID of the teacher assigned to this class" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolId", "name"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "School details."
    },
    "/schools/{schoolId}/classes/{classId}": {
      "schema": "Class",
      "description": "Classes within a school."
    }
  }
}
